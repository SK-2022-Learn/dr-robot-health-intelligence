# Copy this file to .env for local development. Secrets belong in .env and
# must never be committed to source control.
APP_NAME=Dr. Robot
APP_ENV=development

API_HOST=127.0.0.1
API_PORT=8000

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# SQLite remains the authoritative structured data store.
DATABASE_URL=sqlite:///./data/dr_robot.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15

# Pinecone stores document-passage vectors. Keep the API key only in .env.
VECTOR_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE_PREFIX=dr-robot
PINECONE_TIMEOUT_SECONDS=30

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Ollama also supplies the local structured-extraction model.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=150

# Deterministic personal-baseline analytics. These are record-comparison rules,
# not clinical thresholds.
RECENT_WINDOW_DAYS=30
BASELINE_WINDOW_DAYS=90
ANALYTICS_STABILITY_THRESHOLD_PERCENT=5
ANALYTICS_MIN_RECENT_NUMERIC_POINTS=2
ANALYTICS_MIN_BASELINE_NUMERIC_POINTS=2

# Docker only: containers reach a Windows host Ollama through this address.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
